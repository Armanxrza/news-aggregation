# SajhaNews Backend Production Environment Variables

# Option 1: SQLite (Works immediately out-of-the-box, no MySQL setup needed)
DATABASE_URL=sqlite:///news_aggregator.db

# Option 2: MySQL (Create database and user in cPanel MySQL Database Wizard)
# DATABASE_URL=mysql+pymysql://<cpanel_user>_<db_user>:<password>@localhost:3306/<cpanel_user>_<db_name>
