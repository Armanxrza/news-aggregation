# SajhaNews Backend Production Environment Variables

# Production must use a persistent managed database. SQLite on an ephemeral
# web-service filesystem loses stories when the host replaces the instance.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Never disable authentication on a public deployment.
ADMIN_AUTH_DISABLED=false
ADMIN_API_KEY=<long-random-secret>
CORS_ORIGINS=https://sajhanews-frontend.onrender.com

# Keep these off on small instances. Enable only after sizing memory for the
# selected model weights and validating a warm model load.
ENABLE_CRAWL_SCHEDULER=true
CRAWL_INTERVAL_SECONDS=900
EMBEDDING_ENABLED=false
FRAMING_ENABLED=false
EVENT_RERANKER_ENABLED=false
NEPALI_NER_ENABLED=false
ANALYZE_ON_CRAWL=false
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-small
HF_NEPALI_NER_MODEL=SynapseHQ/Finetuned-NER-NepBertA
