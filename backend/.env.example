# SajhaNews local configuration
DATABASE_URL=sqlite:///news_aggregator.db

# Admin API key (send as header X-Admin-Key). For local demos you can disable auth.
ADMIN_API_KEY=dev-admin-key-change-me
ADMIN_AUTH_DISABLED=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Crawler
ENABLE_CRAWL_SCHEDULER=false
CRAWL_INTERVAL_SECONDS=900
ANALYZE_ON_CRAWL=true
ANALYZE_CLAIMS_ON_CRAWL=false

# AI — multilingual pretrained by default. Set FINETUNED_MODEL_PATH only after you fine-tune.
FRAMING_ENABLED=true
EMBEDDING_ENABLED=true
HF_FRAMING_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# FINETUNED_MODEL_PATH=ml/artifacts/framing-nepal

LOG_LEVEL=INFO
